<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Change server" opens the server address dialog,
     "Manage cards" opens the server's setup page to download more cards. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_server"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_change_server">
        <intent
            android:action="app.momobile.CHANGE_SERVER"
            android:targetPackage="app.momobile"
            android:targetClass="app.momobile.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="manage_cards"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_manage_cards">
        <intent
            android:action="app.momobile.MANAGE_CARDS"
            android:targetPackage="app.momobile"
            android:targetClass="app.momobile.MainActivity" />
    </shortcut>
</shortcuts>
